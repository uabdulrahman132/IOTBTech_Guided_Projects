# Copy to terraform.tfvars (gitignored) and edit.
# Every variable in variables.tf must be listed here - there are no defaults.

aws_region   = "us-east-1" # eu-east-1 is not a real AWS region
project_name = "iac-demo"
environment  = "dev"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

instance_type       = "t3.micro"
root_volume_size_gb = 20

ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Your public IP(s): curl -s https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.10/32"]

http_ingress_cidrs = ["0.0.0.0/0"]
